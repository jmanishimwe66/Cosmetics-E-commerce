# Copy to .env and fill in values from the Supabase project settings.
# Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API (future React dev server).
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Not required for the customer-facing API.
# SUPABASE_SERVICE_ROLE_KEY=

# Future frontend (do not put the service-role key here):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
