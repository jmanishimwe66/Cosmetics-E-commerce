# Copy to .env and fill in values from the Supabase project settings.
# Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated browser origins. In production set this to the Railway storefront URL.
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...) or the legacy anon JWT. Not the secret key.
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-side only. Secret key (sb_secret_...) or the legacy service_role JWT.
# SUPABASE_SERVICE_ROLE_KEY=

# Storefront API base. Leave empty in dev to use Vite proxy (/api → localhost:8000).
# Set to http://localhost:8000 when opening the built dist without the dev server.
# Vite reads this file from the repository root. Do not put the secret key in a VITE_ variable.
# VITE_API_URL=
# Production build (Railway): set VITE_API_URL to the public API origin, for example
# https://your-api.up.railway.app
# VITE_WHATSAPP_NUMBER=
# VITE_CONTACT_EMAIL=

# Same project URL and the same publishable/anon key as SUPABASE_ANON_KEY.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
