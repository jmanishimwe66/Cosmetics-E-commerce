# Copy to .env and fill in values from the Supabase project settings.
# Never commit .env.

APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API (future React dev server).
CORS_ORIGINS=http://localhost:5173

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Not required for the customer-facing API.
# SUPABASE_SERVICE_ROLE_KEY=

# Storefront. Optional; defaults to http://localhost:8000.
# Vite reads this file from the repository root. Do not put the service-role key in a VITE_ variable.
VITE_API_URL=http://localhost:8000
